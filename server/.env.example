# Supabase PostgreSQL: copy the host from Dashboard > Connect.
# Direct connection requires IPv6. For IPv4 use the Session pooler (5432).
# Session pooler username: attendance_api.PROJECT_REF; direct: attendance_api.
SUPABASE_DB_HOST=db.PROJECT_REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=attendance_api
# Raw DB role password, NOT a Supabase publishable/secret API key.
SUPABASE_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SUPABASE_DB_SSLMODE=require
# Optional stable-code signing key. If omitted, the database password is used as the key.
# Set this to a long random secret if invite codes must survive database credential rotation.
# CHALLENGE_INVITE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Alternative: remove HOST/USER/PASSWORD above and use a URL-encoded password.
# SUPABASE_DATABASE_URL=postgresql://attendance_api:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Persistent session cookie and server session are renewed on each authenticated request.
# Maximum idle period is 400 days; SESSION_MINUTES is no longer used.
SESSION_DAYS=400
SESSION_COOKIE_NAME=attendance_session
# Use true with HTTPS. SameSite=none also requires this to be true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
CORS_ORIGINS=["http://localhost:3000","http://localhost","capacitor://localhost"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
DOCS_ENABLED=false
MAX_BODY_BYTES=16384
# Private persistent directory; never serve this directory as static files.
PHOTO_STORAGE_DIR=media/photos
# Optional override; defaults to server/notification-config/catalog.json.
# Read on each request, so editing this file does not require a restart.
# NOTIFICATION_CATALOG_PATH=/absolute/path/to/notification-config/catalog.json
# Firebase Cloud Messaging HTTP v1 (Android). The service account is loaded
# using Google Application Default Credentials; never paste its private key here.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Local development only: compose.yaml sets this to the mounted secret path.
# For Docker, set FIREBASE_SERVICE_ACCOUNT_FILE in the project-root .env instead.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# Apple Push Notification service (iOS). Keep the .p8 key outside the repository.
# Use sandbox for Xcode development builds, production for TestFlight/App Store builds.
# APNS_KEY_ID=YOUR_KEY_ID
# APNS_TEAM_ID=YOUR_TEAM_ID
# APNS_AUTH_KEY_PATH=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8
# APNS_TOPIC=com.donskip.attendancecheck
# APNS_ENVIRONMENT=production
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
# Immutable account UUIDs allowed to review reports; empty denies all moderation access.
# Look up the operator account's user_uuid in /api/v1/me or the private users table.
# Email addresses are not used because this app does not verify email ownership.
MODERATOR_USER_UUIDS=[]
