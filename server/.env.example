# Supabase PostgreSQL: copy the host from Dashboard > Connect.
# Direct connection requires IPv6. For IPv4 use the Session pooler (5432).
# Session pooler username: attendance_api.PROJECT_REF; direct: attendance_api.
SUPABASE_DB_HOST=db.PROJECT_REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=attendance_api
# Raw DB role password, NOT a Supabase publishable/secret API key.
SUPABASE_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SUPABASE_DB_SSLMODE=require
# Alternative: remove HOST/USER/PASSWORD above and use a URL-encoded password.
# SUPABASE_DATABASE_URL=postgresql://attendance_api:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Server-side sessions are stored in Supabase PostgreSQL and expire after 3 hours.
SESSION_MINUTES=180
SESSION_COOKIE_NAME=attendance_session
# Use true with HTTPS. SameSite=none also requires this to be true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
CORS_ORIGINS=["http://localhost:3000","http://localhost","capacitor://localhost"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
DOCS_ENABLED=false
MAX_BODY_BYTES=16384
# Private persistent directory; never serve this directory as static files.
PHOTO_STORAGE_DIR=media/photos
# PNG files in this directory are discovered dynamically as image frames.
PHOTO_FRAME_DIR=media/frames
# Optional override; defaults to server/notification-config/catalog.json.
# Read on each request, so editing this file does not require a restart.
# NOTIFICATION_CATALOG_PATH=/absolute/path/to/notification-config/catalog.json
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
