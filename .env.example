# API origin only, without /api/v1. Applied at Next.js build time.
# Physical devices must use the reachable HTTPS API origin, not localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Docker deployment settings: put these in the project-root .env or shell.
# Required by compose.yaml; use the service-account JSON path on the Docker host.
# DOCKER_IMAGE_NAME=your-docker-id/donskipworkout-api:latest
# FIREBASE_SERVICE_ACCOUNT_FILE=/private/firebase-service-account.json
